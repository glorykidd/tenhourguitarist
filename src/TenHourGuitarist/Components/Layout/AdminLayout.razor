@inherits LayoutComponentBase
@attribute [Authorize(Roles = "Admin,Instructor")]

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3">TenHourGuitarist Admin</MudText>
        <MudSpacer />
        <MudButton Href="/" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Home">
            View Site
        </MudButton>
        <AuthorizeView>
            <Authorized>
                <MudText Class="mx-3">@context.User.Identity?.Name</MudText>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <AdminSidebar />
    </MudDrawer>

    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
