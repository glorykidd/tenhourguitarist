@page "/account/login"
@using Microsoft.AspNetCore.Identity
@inject NavigationManager Navigation

<PageTitle>Sign In - TenHourGuitarist</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudPaper Elevation="3" Class="pa-8">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-2">Sign In</MudText>
        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mb-6">
            Welcome back! Sign in to access your courses.
        </MudText>

        <StatusAlert Message="@_errorMessage" Severity="Severity.Error" />

        <form method="post" action="/account/do-login">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <MudTextField @bind-Value="_email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          UserAttributes="_emailAttrs"
                          Class="mb-4" />

            <MudTextField @bind-Value="_password"
                          Label="Password"
                          Variant="Variant.Outlined"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                          OnAdornmentClick="() => _showPassword = !_showPassword"
                          UserAttributes="_passwordAttrs"
                          Class="mb-4" />

            <MudCheckBox @bind-Value="_rememberMe"
                         Label="Remember me"
                         Color="Color.Primary"
                         UserAttributes="_rememberMeAttrs"
                         Class="mb-4" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Class="mb-4">
                Sign In
            </MudButton>
        </form>

        <MudDivider Class="my-4" />

        <div class="d-flex justify-space-between flex-wrap">
            <MudLink Href="/account/forgot-password" Color="Color.Primary">
                Forgot your password?
            </MudLink>
            <MudLink Href="/account/register" Color="Color.Primary">
                Create an account
            </MudLink>
        </div>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    private string? _errorMessage;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _rememberMe;
    private bool _showPassword;

    private static readonly Dictionary<string, object> _emailAttrs = new() { ["name"] = "email" };
    private static readonly Dictionary<string, object> _passwordAttrs = new() { ["name"] = "password" };
    private static readonly Dictionary<string, object> _rememberMeAttrs = new() { ["name"] = "rememberMe" };

    protected override void OnParametersSet()
    {
        _errorMessage = Error switch
        {
            "invalid" => "Invalid email or password.",
            "unconfirmed" => "Please verify your email address before signing in. Check your inbox for the verification link.",
            "locked" => "This account has been locked due to multiple failed sign-in attempts. Please try again later.",
            _ => null
        };
    }
}
