@page "/account/purchases"
@attribute [Authorize]
@inject IOrderService OrderService
@inject ISubscriptionService SubscriptionService
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<PurchaseHistory> Logger

<PageTitle>Purchase History - TenHourGuitarist</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudText Typo="Typo.h4" Class="mb-6">Purchase History</MudText>

    @if (_loading)
    {
        <LoadingSpinner Message="Loading your purchase history..." />
    }
    else
    {
        @* Active Subscription Section *@
        <MudPaper Elevation="2" Class="pa-6 mb-6">
            <MudText Typo="Typo.h5" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.CardMembership" Class="me-2" />
                Current Subscription
            </MudText>

            @if (_activeSubscription is not null)
            {
                <MudCard Outlined="true">
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12" sm="6" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Package</MudText>
                                <MudText Typo="Typo.body1">@(_activeSubscription.Package?.Title ?? "N/A")</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                                <MudChip T="string" Color="@GetStatusColor(_activeSubscription.Status)" Size="Size.Small">
                                    @_activeSubscription.Status
                                </MudChip>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Start Date</MudText>
                                <MudText Typo="Typo.body1">@_activeSubscription.StartDate.ToString("MMM dd, yyyy")</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">End Date</MudText>
                                <MudText Typo="Typo.body1">
                                    @(_activeSubscription.EndDate?.ToString("MMM dd, yyyy") ?? "Ongoing")
                                </MudText>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    You don't have an active subscription.
                    <MudLink Href="/subscription" Color="Color.Primary" Class="ms-2">View plans</MudLink>
                </MudAlert>
            }
        </MudPaper>

        @* Subscription History Section *@
        @if (_subscriptions is not null && _subscriptions.Count > 0)
        {
            <MudPaper Elevation="2" Class="pa-6 mb-6">
                <MudText Typo="Typo.h5" Class="mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Subscriptions" Class="me-2" />
                    Subscription History
                </MudText>

                <MudTable Items="_subscriptions" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Package</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Start Date</MudTh>
                        <MudTh>End Date</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Package">@(context.Package?.Title ?? "N/A")</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">
                                @context.Status
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Start Date">@context.StartDate.ToString("MMM dd, yyyy")</MudTd>
                        <MudTd DataLabel="End Date">@(context.EndDate?.ToString("MMM dd, yyyy") ?? "Ongoing")</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }

        @* Orders Section *@
        <MudPaper Elevation="2" Class="pa-6">
            <MudText Typo="Typo.h5" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="me-2" />
                Orders
            </MudText>

            @if (_orders is null || _orders.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    You don't have any orders yet.
                </MudAlert>
            }
            else
            {
                <MudTable Items="_orders" Hover="true" Dense="false">
                    <HeaderContent>
                        <MudTh>Order Ref</MudTh>
                        <MudTh>Package</MudTh>
                        <MudTh>Amount</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Date</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Order Ref">
                            <MudText Typo="Typo.body2" Style="font-family: monospace;">
                                @context.OrderRefId.ToString("N")[..8].ToUpperInvariant()
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="Package">@(context.Package?.Title ?? "N/A")</MudTd>
                        <MudTd DataLabel="Amount">
                            <MudText Typo="Typo.body1" Color="Color.Primary">
                                @context.Amount.ToString("C")
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Color="@GetPaymentStatusColor(context.PaymentStatus)" Size="Size.Small">
                                @context.PaymentStatus
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Date">
                            @(context.PaymentDate?.ToString("MMM dd, yyyy") ?? context.CreatedAt.ToString("MMM dd, yyyy"))
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <div class="d-flex justify-center pa-4">
                            <MudPagination Count="_totalOrderPages"
                                           Selected="_currentOrderPage"
                                           SelectedChanged="OnOrderPageChanged"
                                           Color="Color.Primary"
                                           ShowFirstButton="true"
                                           ShowLastButton="true" />
                        </div>
                    </PagerContent>
                </MudTable>

                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2" Align="Align.Center">
                    Showing @((_currentOrderPage - 1) * OrderPageSize + 1)-@(Math.Min(_currentOrderPage * OrderPageSize, _totalOrderCount)) of @_totalOrderCount orders
                </MudText>
            }
        </MudPaper>
    }
</MudContainer>

@code {
    private const int OrderPageSize = 20;

    private bool _loading = true;
    private string? _userId;

    private Subscription? _activeSubscription;
    private List<Subscription>? _subscriptions;
    private List<Order>? _orders;

    private int _currentOrderPage = 1;
    private int _totalOrderCount;
    private int _totalOrderPages;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (!string.IsNullOrEmpty(_userId))
        {
            await LoadData();
        }
        else
        {
            _loading = false;
        }
    }

    private async Task LoadData()
    {
        _loading = true;

        try
        {
            _activeSubscription = await SubscriptionService.GetActiveSubscriptionAsync(_userId!);
            _subscriptions = await SubscriptionService.GetByUserIdAsync(_userId!);
            _totalOrderCount = await OrderService.GetUserOrderCountAsync(_userId!);
            _totalOrderPages = Math.Max(1, (int)Math.Ceiling((double)_totalOrderCount / OrderPageSize));
            _orders = await OrderService.GetByUserIdAsync(_userId!, _currentOrderPage, OrderPageSize);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading purchase history for user {UserId}", _userId);
            _orders = [];
            _subscriptions = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnOrderPageChanged(int page)
    {
        _currentOrderPage = page;
        try
        {
            _orders = await OrderService.GetByUserIdAsync(_userId!, _currentOrderPage, OrderPageSize);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading orders page {Page} for user {UserId}", page, _userId);
        }
    }

    private static Color GetStatusColor(SubscriptionStatus status) => status switch
    {
        SubscriptionStatus.Active => Color.Success,
        SubscriptionStatus.Cancelled => Color.Error,
        SubscriptionStatus.Expired => Color.Default,
        SubscriptionStatus.PastDue => Color.Warning,
        _ => Color.Default
    };

    private static Color GetPaymentStatusColor(PaymentStatus status) => status switch
    {
        PaymentStatus.Success => Color.Success,
        PaymentStatus.Pending => Color.Warning,
        PaymentStatus.Failed => Color.Error,
        PaymentStatus.Cancelled => Color.Default,
        _ => Color.Default
    };
}
