@page "/account/reset-password"
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject ILogger<ResetPassword> Logger

<PageTitle>Reset Password - TenHourGuitarist</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudPaper Elevation="3" Class="pa-8">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-2">Reset Password</MudText>
        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mb-6">
            Enter your new password below.
        </MudText>

        @if (_invalidLink)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                This password reset link is invalid or has expired. Please request a new one.
            </MudAlert>
            <MudButton Href="/account/forgot-password"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large">
                Request New Reset Link
            </MudButton>
        }
        else if (_resetComplete)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                Your password has been reset successfully. You can now sign in with your new password.
            </MudAlert>
            <MudButton Href="/account/login"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large">
                Go to Sign In
            </MudButton>
        }
        else
        {
            <StatusAlert Message="@_errorMessage" Severity="Severity.Error" />

            <EditForm Model="_model" OnValidSubmit="HandleReset" FormName="reset-password">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="_model.NewPassword"
                              Label="New Password"
                              Variant="Variant.Outlined"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="() => _showPassword = !_showPassword"
                              For="@(() => _model.NewPassword)"
                              HelperText="At least 8 characters with uppercase, lowercase, digit, and special character."
                              Class="mb-4" />

                <MudTextField @bind-Value="_model.ConfirmPassword"
                              Label="Confirm New Password"
                              Variant="Variant.Outlined"
                              InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="() => _showConfirmPassword = !_showConfirmPassword"
                              For="@(() => _model.ConfirmPassword)"
                              Class="mb-4" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="_processing"
                           Class="mb-4">
                    @if (_processing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                        <span>Resetting Password...</span>
                    }
                    else
                    {
                        <span>Reset Password</span>
                    }
                </MudButton>
            </EditForm>
        }
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    private ResetPasswordModel _model = new();
    private bool _processing;
    private bool _showPassword;
    private bool _showConfirmPassword;
    private bool _resetComplete;
    private bool _invalidLink;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            _invalidLink = true;
        }
    }

    private async Task HandleReset()
    {
        _errorMessage = null;
        _processing = true;

        try
        {
            var user = await UserManager.FindByEmailAsync(Email!);
            if (user is null || user.IsDeleted)
            {
                _invalidLink = true;
                return;
            }

            var result = await UserManager.ResetPasswordAsync(user, Token!, _model.NewPassword);

            if (result.Succeeded)
            {
                Logger.LogInformation("Password reset successful for {Email}", Email);
                _resetComplete = true;
            }
            else
            {
                var errors = result.Errors.Select(e => e.Description).ToList();

                // Check if the token is invalid/expired
                if (errors.Any(e => e.Contains("token", StringComparison.OrdinalIgnoreCase)))
                {
                    _invalidLink = true;
                }
                else
                {
                    _errorMessage = string.Join(" ", errors);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during password reset for {Email}", Email);
            _errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            _processing = false;
        }
    }

    private sealed class ResetPasswordModel
    {
        [Required(ErrorMessage = "New password is required.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Password must be at least 8 characters.")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z\d]).{8,}$",
            ErrorMessage = "Password must contain at least one uppercase letter, one lowercase letter, one digit, and one special character.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your new password.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
