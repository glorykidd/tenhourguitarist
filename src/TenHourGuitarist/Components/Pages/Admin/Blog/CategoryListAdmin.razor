@page "/admin/blog/categories"
@layout AdminLayout
@attribute [Authorize(Policy = "AdminOnly")]

@inject IBlogService BlogService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Manage Blog Categories</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Blog Categories</MudText>
<MudButton Variant="Variant.Filled" Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.Add"
           Href="/admin/blog/categories/new"
           Class="mb-4">
    Add Category
</MudButton>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudDataGrid Items="@_categories" Dense="true" Striped="true" Hover="true" Filterable="true" SortMode="SortMode.Multiple">
        <Columns>
            <PropertyColumn Property="x => x.Title" Title="Title" />
            <PropertyColumn Property="x => x.Slug" Title="Slug" />
            <TemplateColumn Title="Parent">
                <CellTemplate>
                    <MudText>@(context.Item.Parent?.Title ?? "None")</MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Actions" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       Color="Color.Primary"
                                       Href="@($"/admin/blog/categories/{context.Item.Id}")" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteCategory(context.Item))" />
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="BlogCategory" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    private bool _loading = true;
    private List<BlogCategory> _categories = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        _loading = true;
        try
        {
            _categories = await BlogService.GetCategoriesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load categories: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteCategory(BlogCategory category)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete \"{category.Title}\"? This may affect associated blog posts." },
            { x => x.ButtonText, "Delete" },
            { x => x.ButtonColor, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Category", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                await BlogService.DeleteCategoryAsync(category.Id);
                Snackbar.Add("Category deleted successfully.", Severity.Success);
                await LoadCategoriesAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to delete category: {ex.Message}", Severity.Error);
            }
        }
    }
}
