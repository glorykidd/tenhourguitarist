@page "/admin/courses/new"
@page "/admin/courses/{Id:int}"
@layout AdminLayout
@attribute [Authorize(Policy = "InstructorOrAdmin")]

@inject ICourseService CourseService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject UserManager<ApplicationUser> UserManager

@using Microsoft.AspNetCore.Identity
@using System.Text.RegularExpressions

<PageTitle>@(_isEdit ? "Edit Course" : "Add Course")</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@(_isEdit ? "Edit Course" : "Add Course")</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4" Elevation="2">
        <MudForm @ref="_form" @bind-IsValid="_formValid">
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="_course.Name" Label="Name" Required="true"
                                  RequiredError="Name is required"
                                  Immediate="true"
                                  TextChanged="OnNameChanged" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_course.Slug" Label="Slug" Required="true"
                                  RequiredError="Slug is required"
                                  HelperText="Auto-generated from name" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_course.Description" Label="Description"
                                  Lines="5" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect @bind-Value="_course.Level" Label="Level" Required="true">
                        @foreach (var level in Enum.GetValues<CourseLevel>())
                        {
                            <MudSelectItem Value="@level">@level</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_course.Price" Label="Price" Format="N2"
                                     Min="0m" Adornment="Adornment.Start" AdornmentText="$" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_course.DisplayOrder" Label="Display Order"
                                     Min="0" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSwitch @bind-Value="_course.IsFree" Label="Free Course" Color="Color.Primary" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSwitch @bind-Value="_course.IsPublished" Label="Published" Color="Color.Success" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_course.TrailerUrl" Label="Trailer URL" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect @bind-Value="_course.InstructorId" Label="Instructor" Required="true"
                               RequiredError="Instructor is required">
                        @foreach (var instructor in _instructors)
                        {
                            <MudSelectItem Value="@instructor.Id">@instructor.DisplayName (@instructor.Email)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <ImageUpload CurrentImagePath="@_course.CoverImagePath"
                                 Subfolder="courses"
                                 OnUploaded="OnCoverImageUploaded" />
                </MudItem>

                <MudItem xs="12" Class="d-flex gap-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="SaveAsync" Disabled="@(!_formValid || _saving)">
                        @if (_saving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        @(_isEdit ? "Update Course" : "Create Course")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Href="/admin/courses">Cancel</MudButton>
                </MudItem>
            </MudGrid>
        </MudForm>
    </MudPaper>
}

@code {
    [Parameter] public int? Id { get; set; }

    private MudForm _form = null!;
    private bool _formValid;
    private bool _loading = true;
    private bool _saving;
    private bool _isEdit;
    private Course _course = new();
    private List<ApplicationUser> _instructors = [];

    protected override async Task OnInitializedAsync()
    {
        _isEdit = Id.HasValue;

        var instructorUsers = await UserManager.GetUsersInRoleAsync("Instructor");
        var adminUsers = await UserManager.GetUsersInRoleAsync("Admin");
        _instructors = instructorUsers.Union(adminUsers).DistinctBy(u => u.Id).ToList();

        if (_isEdit)
        {
            var course = await CourseService.GetByIdAsync(Id!.Value);
            if (course is null)
            {
                Snackbar.Add("Course not found.", Severity.Error);
                Navigation.NavigateTo("/admin/courses");
                return;
            }
            _course = course;
        }

        _loading = false;
    }

    private void OnNameChanged(string name)
    {
        if (!_isEdit || string.IsNullOrEmpty(_course.Slug))
        {
            _course.Slug = GenerateSlug(name);
        }
    }

    private static string GenerateSlug(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        var slug = text.ToLowerInvariant();
        slug = Regex.Replace(slug, @"[^a-z0-9\s-]", "");
        slug = Regex.Replace(slug, @"\s+", "-");
        slug = Regex.Replace(slug, @"-+", "-");
        return slug.Trim('-');
    }

    private void OnCoverImageUploaded(string path)
    {
        _course.CoverImagePath = path;
    }

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_formValid) return;

        _saving = true;
        try
        {
            if (_isEdit)
            {
                await CourseService.UpdateAsync(_course);
                Snackbar.Add("Course updated successfully.", Severity.Success);
            }
            else
            {
                await CourseService.CreateAsync(_course);
                Snackbar.Add("Course created successfully.", Severity.Success);
            }
            Navigation.NavigateTo("/admin/courses");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save course: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
