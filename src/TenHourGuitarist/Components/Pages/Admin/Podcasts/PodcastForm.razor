@page "/admin/podcasts/new"
@page "/admin/podcasts/{Id:int}"
@layout AdminLayout
@attribute [Authorize(Policy = "AdminOnly")]

@inject IPodcastService PodcastService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

@using System.Text.RegularExpressions

<PageTitle>@(_isEdit ? "Edit Podcast" : "Add Podcast")</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@(_isEdit ? "Edit Podcast" : "Add Podcast")</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4" Elevation="2">
        <MudForm @ref="_form" @bind-IsValid="_formValid">
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="_podcast.Name" Label="Name" Required="true"
                                  RequiredError="Name is required"
                                  Immediate="true"
                                  TextChanged="OnNameChanged" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_podcast.Slug" Label="Slug" Required="true"
                                  RequiredError="Slug is required"
                                  HelperText="Auto-generated from name" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_podcast.Description" Label="Description"
                                  Lines="5" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_podcast.AudioFileUrl" Label="Audio File URL"
                                  HelperText="Enter the URL to the audio file" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_publishedDate" Label="Published Date"
                                   Placeholder="Select date" Clearable="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSwitch @bind-Value="_podcast.IsPublished" Label="Published" Color="Color.Success" />
                </MudItem>

                <MudItem xs="12" Class="d-flex gap-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="SaveAsync" Disabled="@(!_formValid || _saving)">
                        @if (_saving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        @(_isEdit ? "Update Podcast" : "Create Podcast")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Href="/admin/podcasts">Cancel</MudButton>
                </MudItem>
            </MudGrid>
        </MudForm>
    </MudPaper>
}

@code {
    [Parameter] public int? Id { get; set; }

    private MudForm _form = null!;
    private bool _formValid;
    private bool _loading = true;
    private bool _saving;
    private bool _isEdit;
    private Podcast _podcast = new();
    private DateTime? _publishedDate;
    private string _currentUserId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _isEdit = Id.HasValue;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        if (_isEdit)
        {
            var podcast = await PodcastService.GetByIdAsync(Id!.Value);
            if (podcast is null)
            {
                Snackbar.Add("Podcast not found.", Severity.Error);
                Navigation.NavigateTo("/admin/podcasts");
                return;
            }
            _podcast = podcast;
            _publishedDate = podcast.PublishedDate;
        }
        else
        {
            _podcast.AuthorId = _currentUserId;
        }

        _loading = false;
    }

    private void OnNameChanged(string name)
    {
        if (!_isEdit || string.IsNullOrEmpty(_podcast.Slug))
        {
            _podcast.Slug = GenerateSlug(name);
        }
    }

    private static string GenerateSlug(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        var slug = text.ToLowerInvariant();
        slug = Regex.Replace(slug, @"[^a-z0-9\s-]", "");
        slug = Regex.Replace(slug, @"\s+", "-");
        slug = Regex.Replace(slug, @"-+", "-");
        return slug.Trim('-');
    }

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_formValid) return;

        _saving = true;
        try
        {
            _podcast.PublishedDate = _publishedDate;

            if (_isEdit)
            {
                await PodcastService.UpdateAsync(_podcast);
                Snackbar.Add("Podcast updated successfully.", Severity.Success);
            }
            else
            {
                _podcast.AuthorId = _currentUserId;
                await PodcastService.CreateAsync(_podcast);
                Snackbar.Add("Podcast created successfully.", Severity.Success);
            }
            Navigation.NavigateTo("/admin/podcasts");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save podcast: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
