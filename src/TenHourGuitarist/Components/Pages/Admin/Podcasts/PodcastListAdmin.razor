@page "/admin/podcasts"
@layout AdminLayout
@attribute [Authorize(Policy = "AdminOnly")]

@inject IPodcastService PodcastService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Manage Podcasts</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Podcasts</MudText>
<MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               Href="/admin/podcasts/new" Class="mb-4">
        Add Podcast
    </MudButton>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudDataGrid Items="@_podcasts" Dense="true" Striped="true" Hover="true" Filterable="true" SortMode="SortMode.Multiple">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <TemplateColumn Title="Author">
                <CellTemplate>
                    <MudText>@context.Item.Author?.DisplayName</MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Published Date">
                <CellTemplate>
                    <MudText>@(context.Item.PublishedDate?.ToString("MMM dd, yyyy") ?? "Draft")</MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Published">
                <CellTemplate>
                    <MudIcon Icon="@(context.Item.IsPublished ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                             Color="@(context.Item.IsPublished ? Color.Success : Color.Default)" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Actions" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       Color="Color.Primary"
                                       Href="@($"/admin/podcasts/{context.Item.Id}")" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => DeletePodcast(context.Item))" />
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="Podcast" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    private bool _loading = true;
    private List<Podcast> _podcasts = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadPodcastsAsync();
    }

    private async Task LoadPodcastsAsync()
    {
        _loading = true;
        try
        {
            _podcasts = await PodcastService.GetAllAsync(publishedOnly: false, page: 1, pageSize: 1000);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load podcasts: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeletePodcast(Podcast podcast)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete \"{podcast.Name}\"?" },
            { x => x.ButtonText, "Delete" },
            { x => x.ButtonColor, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Podcast", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                await PodcastService.DeleteAsync(podcast.Id);
                Snackbar.Add("Podcast deleted successfully.", Severity.Success);
                await LoadPodcastsAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to delete podcast: {ex.Message}", Severity.Error);
            }
        }
    }
}
