@page "/blog"
@inject IBlogService BlogService

<PageTitle>Blog - TenHourGuitarist</PageTitle>

<section class="bg-dark text-white py-5">
    <div class="container text-center">
        <h1 class="display-5 fw-bold">Blog</h1>
        <p class="lead mt-3">Tips, techniques, and stories from the guitar world.</p>
    </div>
</section>

<section class="container py-5">
    @if (_loading)
    {
        <LoadingSpinner />
    }
    else if (!_posts.Any())
    {
        <div class="text-center py-5">
            <MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Large" Class="mb-3 text-muted" />
            <MudText Typo="Typo.h6" Class="text-muted">No blog posts available yet.</MudText>
        </div>
    }
    else
    {
        <div class="row g-4">
        @foreach (var post in _posts)
        {
            <div class="col-lg-6">
                <div class="card h-100 shadow-sm">
                    <div class="row g-0 h-100">
                        @if (!string.IsNullOrEmpty(post.FeaturedImagePath))
                        {
                            <div class="col-md-4">
                                <img src="@post.FeaturedImagePath"
                                     alt="@post.Title"
                                     class="img-fluid rounded-start h-100"
                                     style="object-fit: cover;" />
                            </div>
                        }
                        <div class="@(!string.IsNullOrEmpty(post.FeaturedImagePath) ? "col-md-8" : "col-12")">
                            <div class="card-body d-flex flex-column">
                                <div class="mb-2">
                                    @if (post.Category is not null)
                                    {
                                        <span class="badge bg-primary me-2">@post.Category.Title</span>
                                    }
                                    @if (post.PublishedDate.HasValue)
                                    {
                                        <small class="text-muted">@post.PublishedDate.Value.ToString("MMMM d, yyyy")</small>
                                    }
                                </div>
                                <h5 class="card-title">
                                    <a href="/blog/@post.Slug" class="text-decoration-none text-dark">@post.Title</a>
                                </h5>
                                <p class="card-text text-muted flex-grow-1">
                                    @StripHtmlAndTruncate(post.Content, 200)
                                </p>
                                <div>
                                    <a href="/blog/@post.Slug" class="btn btn-outline-primary btn-sm">Read More</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        </div>

        @if (_totalPages > 1)
        {
            <div class="d-flex justify-content-center mt-5">
                <MudPagination Count="_totalPages"
                               Selected="_currentPage"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary"
                               ShowFirstButton="true"
                               ShowLastButton="true" />
            </div>
        }
    }
</section>

@code {
    private List<Data.Entities.BlogPost> _posts = [];
    private bool _loading = true;
    private int _currentPage = 1;
    private int _totalPages = 1;
    private const int PageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadPostsAsync();
    }

    private async Task LoadPostsAsync()
    {
        _loading = true;

        var totalCount = await BlogService.GetTotalCountAsync();
        _totalPages = (int)Math.Ceiling((double)totalCount / PageSize);
        if (_totalPages < 1) _totalPages = 1;

        _posts = await BlogService.GetAllAsync(publishedOnly: true, page: _currentPage, pageSize: PageSize);
        _loading = false;
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadPostsAsync();
    }

    private static string StripHtmlAndTruncate(string? content, int maxLength)
    {
        if (string.IsNullOrEmpty(content)) return string.Empty;

        // Remove HTML tags
        var stripped = System.Text.RegularExpressions.Regex.Replace(content, "<[^>]+>", " ");
        // Collapse whitespace
        stripped = System.Text.RegularExpressions.Regex.Replace(stripped, @"\s+", " ").Trim();

        if (stripped.Length <= maxLength) return stripped;
        return stripped[..maxLength] + "...";
    }
}
