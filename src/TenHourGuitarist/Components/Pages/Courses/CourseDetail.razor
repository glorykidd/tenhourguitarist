@page "/courses/{Slug}"
@inject ICourseService CourseService
@inject ILessonService LessonService

<PageTitle>@(_course?.Name ?? "Course") - TenHourGuitarist</PageTitle>

@if (_loading)
{
    <LoadingSpinner Message="Loading course..." />
}
else if (_course is null)
{
    <section class="container py-5 text-center">
        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Class="mb-3 text-muted" />
        <MudText Typo="Typo.h5" Class="text-muted">Course not found.</MudText>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/courses" Class="mt-3">
            Back to Courses
        </MudButton>
    </section>
}
else
{
    <!-- Course header -->
    <section class="bg-dark text-white py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-3">
                            <li class="breadcrumb-item"><a href="/courses" class="text-white-50">Courses</a></li>
                            <li class="breadcrumb-item active text-white" aria-current="page">@_course.Name</li>
                        </ol>
                    </nav>
                    <h1 class="display-5 fw-bold">@_course.Name</h1>
                    <div class="mt-3">
                        <MudChip T="string" Color="@GetLevelColor()" Size="Size.Small">@_course.Level.ToString()</MudChip>
                        @if (_course.IsFree)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">Free</MudChip>
                        }
                    </div>
                    @if (_course.Instructor is not null)
                    {
                        <p class="mt-3 text-white-50">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="me-1" />
                            Instructor: @_course.Instructor.DisplayName
                        </p>
                    }
                    <p class="mt-2 text-white-50">@_lessons.Count lesson@(_lessons.Count != 1 ? "s" : "")</p>
                </div>
                <div class="col-lg-5 mt-4 mt-lg-0">
                    @if (!string.IsNullOrEmpty(_course.CoverImagePath))
                    {
                        <img src="@_course.CoverImagePath" alt="@_course.Name" class="img-fluid rounded shadow" />
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="container py-5">
        <div class="row">
            <div class="col-lg-8">
                <!-- Trailer video -->
                @if (!string.IsNullOrEmpty(_course.TrailerUrl))
                {
                    <h3 class="mb-3">Course Trailer</h3>
                    <div class="mb-5">
                        <VimeoPlayer VideoUrl="@_course.TrailerUrl" />
                    </div>
                }

                <!-- Description -->
                @if (!string.IsNullOrEmpty(_course.Description))
                {
                    <h3 class="mb-3">About This Course</h3>
                    <div class="mb-5">
                        <p>@_course.Description</p>
                    </div>
                }
            </div>

            <!-- Lesson list sidebar -->
            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Lessons</h5>
                    </div>
                    <div class="list-group list-group-flush">
                        @if (!_lessons.Any())
                        {
                            <div class="list-group-item text-muted">No lessons available yet.</div>
                        }
                        else
                        {
                            @foreach (var (lesson, index) in _lessons.Select((l, i) => (l, i)))
                            {
                                <a href="/courses/@_course.Slug/lessons/@lesson.Slug"
                                   class="list-group-item list-group-item-action d-flex align-items-center">
                                    <span class="badge bg-secondary me-3">@(index + 1)</span>
                                    <div>
                                        <div class="fw-semibold">@lesson.Name</div>
                                        @if (lesson.DurationMinutes > 0 || lesson.DurationSeconds > 0)
                                        {
                                            <small class="text-muted">
                                                @FormatDuration(lesson.DurationMinutes, lesson.DurationSeconds)
                                            </small>
                                        }
                                    </div>
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private Course? _course;
    private List<Lesson> _lessons = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _course = await CourseService.GetBySlugAsync(Slug);
        if (_course is not null)
        {
            _lessons = await LessonService.GetByCourseIdAsync(_course.Id);
        }
        _loading = false;
    }

    private Color GetLevelColor() => _course?.Level switch
    {
        CourseLevel.Beginner => Color.Success,
        CourseLevel.Intermediate => Color.Warning,
        CourseLevel.Advanced => Color.Error,
        _ => Color.Default
    };

    private static string FormatDuration(int minutes, int seconds)
    {
        if (minutes > 0 && seconds > 0)
            return $"{minutes}m {seconds}s";
        if (minutes > 0)
            return $"{minutes} min";
        return $"{seconds}s";
    }
}
