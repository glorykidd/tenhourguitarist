@page "/not-found"
@layout MainLayout

<PageTitle>Page Not Found - TenHourGuitarist</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-16 text-center">
    <MudText Typo="Typo.h1" Style="font-size: 8rem; font-weight: 700; line-height: 1;" Color="Color.Primary">
        404
    </MudText>

    <MudText Typo="Typo.h4" Class="mt-2 mb-2">
        Page Not Found
    </MudText>

    <MudText Typo="Typo.body1" Class="mb-6" Color="Color.Secondary">
        Sorry, the page you are looking for does not exist or may have been moved.
        Check the URL for errors, or head back to the home page.
    </MudText>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" Size="Size.Large">
        Back to Home
    </MudButton>
</MudContainer>
