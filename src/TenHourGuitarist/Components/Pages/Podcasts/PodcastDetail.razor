@page "/podcasts/{Slug}"
@inject IPodcastService PodcastService

<PageTitle>@(_podcast?.Name ?? "Podcast") - TenHourGuitarist</PageTitle>

@if (_loading)
{
    <LoadingSpinner Message="Loading podcast..." />
}
else if (_podcast is null)
{
    <section class="container py-5 text-center">
        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Class="mb-3 text-muted" />
        <MudText Typo="Typo.h5" Class="text-muted">Podcast not found.</MudText>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/podcasts" Class="mt-3">
            Back to Podcasts
        </MudButton>
    </section>
}
else
{
    <section class="bg-dark text-white py-5">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/podcasts" class="text-white-50">Podcasts</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">@_podcast.Name</li>
                </ol>
            </nav>
            <h1 class="display-5 fw-bold">@_podcast.Name</h1>
            <div class="d-flex align-items-center mt-3 text-white-50">
                @if (_podcast.Author is not null)
                {
                    <span class="me-3">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="me-1" />
                        @_podcast.Author.DisplayName
                    </span>
                }
                @if (_podcast.PublishedDate.HasValue)
                {
                    <span>
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="me-1" />
                        @_podcast.PublishedDate.Value.ToString("MMMM d, yyyy")
                    </span>
                }
            </div>
        </div>
    </section>

    <section class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Audio player -->
                @if (!string.IsNullOrEmpty(_podcast.AudioFileUrl))
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <h5 class="card-title mb-3">Listen Now</h5>
                            <AudioPlayer AudioUrl="@_podcast.AudioFileUrl" />
                        </div>
                    </div>
                }

                <!-- Full description -->
                @if (!string.IsNullOrEmpty(_podcast.Description))
                {
                    <h4 class="mb-3">About This Episode</h4>
                    <div class="mb-4">
                        <p>@_podcast.Description</p>
                    </div>
                }

                <hr class="mt-4 mb-4" />

                <a href="/podcasts" class="btn btn-outline-secondary">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="me-1" />
                    Back to Podcasts
                </a>
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private Podcast? _podcast;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _podcast = await PodcastService.GetBySlugAsync(Slug);
        _loading = false;
    }
}
