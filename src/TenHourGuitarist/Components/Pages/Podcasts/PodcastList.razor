@page "/podcasts"
@inject IPodcastService PodcastService

<PageTitle>Podcasts - TenHourGuitarist</PageTitle>

<section class="bg-dark text-white py-5">
    <div class="container text-center">
        <h1 class="display-5 fw-bold">Podcasts</h1>
        <p class="lead mt-3">Listen to discussions on guitar techniques, gear, and the musician's journey.</p>
    </div>
</section>

<section class="container py-5">
    @if (_loading)
    {
        <LoadingSpinner />
    }
    else if (!_podcasts.Any())
    {
        <div class="text-center py-5">
            <MudIcon Icon="@Icons.Material.Filled.Podcasts" Size="Size.Large" Class="mb-3 text-muted" />
            <MudText Typo="Typo.h6" Class="text-muted">No podcasts available yet.</MudText>
        </div>
    }
    else
    {
        <div class="row g-4">
        @foreach (var podcast in _podcasts)
        {
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="card-title mb-1">
                                    <a href="/podcasts/@podcast.Slug" class="text-decoration-none text-dark">
                                        @podcast.Name
                                    </a>
                                </h5>
                                @if (podcast.PublishedDate.HasValue)
                                {
                                    <small class="text-muted">
                                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="me-1" />
                                        @podcast.PublishedDate.Value.ToString("MMMM d, yyyy")
                                    </small>
                                }
                            </div>
                            <a href="/podcasts/@podcast.Slug" class="btn btn-outline-primary btn-sm flex-shrink-0">
                                Details
                            </a>
                        </div>
                        <p class="card-text text-muted mb-3">
                            @(podcast.Description?.Length > 300 ? podcast.Description[..300] + "..." : podcast.Description)
                        </p>
                        @if (!string.IsNullOrEmpty(podcast.AudioFileUrl))
                        {
                            <AudioPlayer AudioUrl="@podcast.AudioFileUrl" />
                        }
                    </div>
                </div>
            </div>
        }
        </div>

        @if (_totalPages > 1)
        {
            <div class="d-flex justify-content-center mt-5">
                <MudPagination Count="_totalPages"
                               Selected="_currentPage"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary"
                               ShowFirstButton="true"
                               ShowLastButton="true" />
            </div>
        }
    }
</section>

@code {
    private List<Podcast> _podcasts = [];
    private bool _loading = true;
    private int _currentPage = 1;
    private int _totalPages = 1;
    private const int PageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadPodcastsAsync();
    }

    private async Task LoadPodcastsAsync()
    {
        _loading = true;

        var totalCount = await PodcastService.GetTotalCountAsync();
        _totalPages = (int)Math.Ceiling((double)totalCount / PageSize);
        if (_totalPages < 1) _totalPages = 1;

        _podcasts = await PodcastService.GetAllAsync(publishedOnly: true, page: _currentPage, pageSize: PageSize);
        _loading = false;
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadPodcastsAsync();
    }
}
