@page "/subscribe/cancel"

<PageTitle>Checkout Cancelled - TenHourGuitarist</PageTitle>

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center">
            <div class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Warning" Style="font-size: 5rem;" />
            </div>
            <h1 class="display-6 fw-bold mb-3">Checkout Cancelled</h1>
            <p class="lead text-muted mb-4">
                Your checkout was cancelled. No charges have been made. You can return to our subscription
                packages anytime to complete your purchase.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/subscribe/packages" class="btn btn-primary btn-lg">View Packages</a>
                <a href="/" class="btn btn-outline-secondary btn-lg">Go Home</a>
            </div>
        </div>
    </div>
</section>
