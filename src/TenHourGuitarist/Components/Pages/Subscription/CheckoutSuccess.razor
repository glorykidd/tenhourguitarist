@page "/subscribe/success"

<PageTitle>Subscription Successful - TenHourGuitarist</PageTitle>

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center">
            <div class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="font-size: 5rem;" />
            </div>
            <h1 class="display-6 fw-bold mb-3">Thank You!</h1>
            <p class="lead text-muted mb-4">
                Your subscription has been activated successfully. You now have full access to all our
                premium courses and lessons.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/courses" class="btn btn-primary btn-lg">Browse Courses</a>
                <a href="/" class="btn btn-outline-secondary btn-lg">Go Home</a>
            </div>
        </div>
    </div>
</section>
